{
  "name": "@qqs/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:backend": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx",
    "test:coverage": "node --test --import tsx --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/test-support/**' --test-coverage-exclude='**/test-database.ts'",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@qqs/contracts": "0.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.4",
    "node-mocks-http": "^1.17.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
