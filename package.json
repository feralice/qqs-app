{
  "name": "qqs-app",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@qqs/backend",
    "dev:frontend": "npm start --workspace=@qqs/frontend",
    "dev:web": "npm run web --workspace=@qqs/frontend",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "node --test",
    "lint": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "expo-router": "~57.0.22",
    "typescript": "^5.9.2"
  }
}
