{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "react-native": ["./node_modules/react-native-web"]
    }
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.tsx",
    "src/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
